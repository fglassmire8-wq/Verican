# Local SQLite. Prisma resolves this relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Later host — Postgres. Also change provider in prisma/schema.prisma from
# "sqlite" to "postgresql". Do not apply the SQLite migration SQL to Postgres;
# use `npx prisma db push` (or a fresh migrate) against the new database.
# No paid database is required to run VERICAN locally.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/verican?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
SEED_OWNER_PASSWORD="replace-with-a-strong-owner-password"

# Runtime review photos (the MAX A/C seed stays in public/uploads/max-ac/).
# Unset, this is data/uploads (gitignored). On Fly/Railway mount a volume here
# so new photos survive deploys. Vercel has no persistent disk.
# UPLOAD_DIR="/data/uploads"
