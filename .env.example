# Local SQLite. Prisma resolves this relative to the prisma/ directory.
# Production (Railway volume): file:/data/prod.db
# Production (hosted Postgres): postgresql://USER:PASSWORD@HOST:5432/verican?sslmode=require
# When DATABASE_URL is postgres, Docker start uses prisma-postgres/ migrations.
# Do not apply prisma/migrations (SQLite SQL) to Postgres.
DATABASE_URL="file:./dev.db"

# Public origin of this instance. Local: http://localhost:3000
# Railway: https://<your-service>.up.railway.app
# Custom domain later: https://vericann.com
NEXTAUTH_URL="http://localhost:3000"

NEXTAUTH_SECRET="replace-with-a-long-random-string"
SEED_OWNER_PASSWORD="replace-with-a-strong-owner-password"

# Runtime review photos (the MAX A/C seed stays in public/uploads/max-ac/).
# Unset, this is data/uploads (gitignored). On Railway mount a volume at /data
# and set this to /data/uploads so new photos survive deploys.
# Vercel has no persistent disk — do not use it for v1.
# UPLOAD_DIR="/data/uploads"
